---
import type { PostSummary } from '../lib/posts';
import { postsLength } from '../lib/posts';
interface Props {
  categoryEntries: Array<[string, PostSummary[]]>;
  tagEntries: Array<[string, PostSummary[]]>;
  activeCategory?: string | null;
  activeTag?: string | null;
}

const { categoryEntries, tagEntries, activeCategory = null, activeTag = null } = Astro.props;
---

<nav class="min-w-0">
  <a
    class:list={[
      'block rounded-md px-2 py-1.5 text-sm',
      !activeCategory && !activeTag
        ? 'bg-slate-200 text-slate-900'
        : 'text-slate-700 hover:bg-slate-100',
    ]}
    href="/"
  >
    全部文章
  </a>

  <div class="mt-4">
    <span class="flex-row">
    <p class="text-base font-semibold text-slate-900 inline-block">分类导航</p>
      <p class="float-end text-base font-semibold text-slate-900 inline-block">
        总文章数:{postsLength}
      </p>
    </span>
    {
      categoryEntries.length === 0 ? (
        <p class="mt-2 text-sm text-slate-500">暂无分类</p>
      ) : (
        <ul class="mt-3 space-y-2 text-sm">
          {categoryEntries.map(([name, list]) => (
            <li>
                <a
                class:list={[
                  'flex items-center justify-between gap-2 rounded-md px-2 py-1.5',
                  activeCategory === name
                    ? 'bg-sky-100 text-sky-800'
                    : 'text-slate-700 hover:bg-sky-50 hover:text-sky-700',
                ]}
                href={`/category/${encodeURIComponent(name)}`}
              >
                <span class="min-w-0 flex-1 truncate">{name}</span>
                <span class="shrink-0 text-xs text-slate-500">{list.length}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>

  <div class="mt-6 border-t border-slate-200 pt-4">
    <h2 class="text-base font-semibold text-slate-900">标签导航</h2>
    {
      tagEntries.length === 0 ? (
        <p class="mt-2 text-sm text-slate-500">暂无标签</p>
      ) : (
        <div class="mt-3 flex flex-wrap gap-2">
          {tagEntries.map(([name, list]) => (
            <a
              class:list={[
                'max-w-full break-all rounded-full px-3 py-1 text-xs',
                activeTag === name
                  ? 'bg-emerald-200 text-emerald-900'
                  : 'bg-emerald-50 text-emerald-700 hover:bg-emerald-100',
              ]}
              href={`/tag/${encodeURIComponent(name)}`}
              title={`${name} (${list.length})`}
            >
              #{name}
            </a>
          ))}
        </div>
      )
    }
  </div>
</nav>
