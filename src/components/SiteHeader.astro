---
import { Home, Info } from '@lucide/astro';
import GlobalSearch from './GlobalSearch.astro';

interface Props {
  showHomeLink?: boolean;
  showAboutLink?: boolean;
}

const {
  showHomeLink = false,
  showAboutLink = true,
} = Astro.props;
---

<header class="fixed inset-x-0 top-0 z-40 border-b border-white/20 bg-sky-400/95 backdrop-blur-sm">
  <div class="flex h-16 items-center gap-3 px-4 lg:grid lg:grid-cols-[280px_minmax(0,1fr)] lg:gap-0 lg:px-0">
    <div class="flex min-w-0 items-center lg:h-full lg:border-r lg:border-white/15 lg:px-4">
      <a href="/" class="min-w-0 pl-1.5 text-2xl font-bold text-white transition hover:opacity-95">
        蔚蓝之家
      </a>
    </div>

    <div class="ml-auto flex items-center gap-2 lg:justify-end lg:px-4">
      <GlobalSearch />

      {showAboutLink ? (
        <a
          href="/about"
          class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/30 bg-white/16 text-white shadow-sm backdrop-blur-sm transition hover:bg-white/24 focus:outline-none focus:ring-2 focus:ring-white/70 focus:ring-offset-2 focus:ring-offset-sky-400 motion-reduce:transition-none"
          aria-label="关于页面"
        >
          <Info size={18} />
        </a>
      ) : null}

      {showHomeLink ? (
        <a
          href="/"
          class="inline-flex items-center gap-2 rounded-full border border-white/30 bg-white/16 px-3 text-sm font-medium text-white shadow-sm backdrop-blur-sm transition hover:bg-white/24 focus:outline-none focus:ring-2 focus:ring-white/70 focus:ring-offset-2 focus:ring-offset-sky-400 motion-reduce:transition-none"
        >
          <Home size={18} />
          <span class="hidden sm:inline">首页</span>
        </a>
      ) : null}
    </div>
  </div>
</header>
