---
import { Home, Info, Moon, Sun } from '@lucide/astro';
import GlobalSearch from './GlobalSearch.astro';

interface Props {
  showHomeLink?: boolean;
  showAboutLink?: boolean;
}

const {
  showHomeLink = false,
  showAboutLink = true,
} = Astro.props;
---

<header class="site-header">
  <div class="flex h-16 items-center gap-3 px-4 lg:grid lg:grid-cols-[280px_minmax(0,1fr)] lg:gap-0 lg:px-0">
    <div class="site-brand-cell flex items-center lg:px-4">
      <a href="/" class="site-brand min-w-0 pl-1.5 text-2xl">
        蔚蓝之家
      </a>
    </div>

    <div class="ml-auto flex items-center gap-2 lg:justify-end lg:px-4">
      <GlobalSearch />

      <button
        type="button"
        data-theme-toggle
        class="header-icon-button"
        aria-label="切换暗色模式"
      >
        <Sun size={18} class="hidden dark:block" />
        <Moon size={18} class="block dark:hidden" />
      </button>

      {showAboutLink ? (
        <a
          href="/about"
          class="header-icon-button"
          aria-label="关于页面"
        >
          <Info size={18} />
        </a>
      ) : null}

      {showHomeLink ? (
        <a
          href="/"
          class="header-link-button"
        >
          <Home size={18} />
          <span class="hidden sm:inline">首页</span>
        </a>
      ) : null}
    </div>
  </div>
</header>

<script>
  function initThemeToggle() {
    const toggle = document.querySelector('[data-theme-toggle]');
    if (!toggle) return;

    toggle.addEventListener('click', () => {
      const root = document.documentElement;
      const isDark = root.classList.toggle('dark');
      try {
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      } catch (e) {}
    });
  }

  initThemeToggle();
</script>
