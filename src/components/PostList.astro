---
import type { PostSummary } from '../lib/posts';

interface Props {
  title: string;
  posts: PostSummary[];
  emptyText?: string;
}

const { title, posts, emptyText = '暂无文章。' } = Astro.props;

function formatDate(value: string | null) {
  if (!value) return '未知日期';
  const normalized = value.trim().replace(' ', 'T');
  const date = new Date(normalized);
  if (Number.isNaN(date.getTime())) return value;
  return new Intl.DateTimeFormat('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).format(date);
}
---

<article class="surface-panel p-5 sm:p-6">
  <h2 class="section-title text-xl font-semibold">{title}</h2>
  {
    posts.length === 0 ? (
      <p class="muted-text mt-3 text-sm">{emptyText}</p>
    ) : (
      <div class="mt-4 space-y-3">
        {posts.map((post) => (
          <a
            href={`/posts/${encodeURIComponent(post.slug)}`}
            class="surface-card interactive-card block p-4"
          >
            <h3 class="card-title break-words text-base font-semibold">{post.title}</h3>
            <p class="card-meta mt-1 text-xs">{formatDate(post.date)}</p>
            {post.description ? <p class="card-copy mt-2 break-words text-sm">{post.description}</p> : null}
          </a>
        ))}
      </div>
    )
  }
</article>
