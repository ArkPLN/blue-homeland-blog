---
import type { PostSummary } from '../lib/posts';

interface Props {
  title: string;
  posts: PostSummary[];
  emptyText?: string;
}

const { title, posts, emptyText = '暂无文章。' } = Astro.props;

function formatDate(value: string | null) {
  if (!value) return '未知日期';
  const normalized = value.trim().replace(' ', 'T');
  const date = new Date(normalized);
  if (Number.isNaN(date.getTime())) return value;
  return new Intl.DateTimeFormat('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).format(date);
}
---

<article class="rounded-xl bg-white/85 p-5 shadow-sm backdrop-blur-sm dark:bg-slate-800/85">
  <h2 class="text-xl font-semibold dark:text-slate-100">{title}</h2>
  {
    posts.length === 0 ? (
      <p class="mt-3 text-sm text-slate-500 dark:text-slate-400">{emptyText}</p>
    ) : (
      <div class="mt-4 space-y-3">
        {posts.map((post) => (
          <a
            href={`/posts/${encodeURIComponent(post.slug)}`}
            class="block rounded-lg border border-slate-200 bg-slate-50/70 p-4 transition hover:border-sky-300 hover:bg-white dark:border-slate-700 dark:bg-slate-700/50 dark:hover:border-sky-600 dark:hover:bg-slate-700"
          >
            <h3 class="break-words text-base font-semibold text-slate-900 dark:text-slate-100">{post.title}</h3>
            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">{formatDate(post.date)}</p>
            {post.description ? <p class="mt-2 break-words text-sm text-slate-700 dark:text-slate-300">{post.description}</p> : null}
          </a>
        ))}
      </div>
    )
  }
</article>
