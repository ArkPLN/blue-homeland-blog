---
import { LoaderCircle, Search, Sparkles, X } from '@lucide/astro';

interface Props {
  endpoint?: string;
  placeholder?: string;
}

const {
  endpoint = '/search-index.json',
  placeholder = '搜索标题或正文...',
} = Astro.props;

---

<div class="flex items-center gap-2" data-global-search-root data-search-endpoint={endpoint}>
  <button
    type="button"
    data-search-open
    class="header-search-button"
    aria-label="打开全局搜索"
    aria-haspopup="dialog"
    aria-controls="global-search-dialog"
    aria-expanded="false"
  >
    <span class="header-search-icon">
      <Search size={17} />
    </span>
    <span class="hidden sm:inline">搜索</span>
    <span class="header-shortcut hidden md:inline">CTRL K</span>
  </button>

  <div
    id="global-search-dialog"
    data-search-overlay
    class="search-overlay pointer-events-none fixed inset-0 z-[70] hidden opacity-0"
    aria-hidden="true"
  >
    <div data-search-backdrop class="search-backdrop absolute inset-0"></div>
    <div class="search-ambient pointer-events-none absolute inset-x-0 top-0 h-56"></div>

    <div class="flex min-h-screen items-center justify-center px-3 py-3 sm:px-6 sm:py-6">
      <section
        role="dialog"
        aria-modal="true"
        aria-labelledby="global-search-title"
        class="search-panel-shell pointer-events-auto flex max-h-[calc(100dvh-1.5rem)] w-full max-w-[min(94vw,1040px)] translate-y-6 scale-[0.97] flex-col overflow-hidden sm:max-h-[min(78vh,760px)] sm:max-w-[min(90vw,1040px)]"
        data-search-panel
      >
        <div class="search-panel-noise"></div>
        <div class="search-panel-header relative px-4 py-4 sm:px-7 sm:py-5">
          <div class="flex items-center gap-3">
            <div class="search-dialog-icon flex h-11 w-11 items-center justify-center sm:h-13 sm:w-13">
              <Search size={18} />
            </div>
            <div class="min-w-0 flex-1">
              <p id="global-search-title" class="search-dialog-title text-[1.45rem] font-semibold sm:text-[1.7rem]">全局搜索</p>
              <p class="search-dialog-subtitle mt-1 text-[13px] sm:text-sm">支持标题和正文内容检索</p>
            </div>
            <button
              type="button"
              data-search-close
              class="search-close-button inline-flex h-11 w-11 items-center justify-center sm:h-12 sm:w-12"
              aria-label="关闭搜索"
            >
              <X size={18} />
            </button>
          </div>

          <div class="search-input-shell mt-4 overflow-hidden sm:mt-5">
            <label for="global-search-input" class="sr-only">搜索标题或正文</label>
            <div class="flex items-center gap-3 px-4 py-3 sm:px-5 sm:py-4">
              <span class="search-input-icon flex h-10 w-10 shrink-0 items-center justify-center sm:h-11 sm:w-11">
                <Search size={18} />
              </span>
              <input
                id="global-search-input"
                data-search-input
                type="search"
                inputmode="search"
                placeholder={placeholder}
                class="search-input h-11 min-w-0 flex-1 bg-transparent text-[1rem] font-medium outline-none sm:h-12 sm:text-[1.05rem]"
                autocomplete="off"
                spellcheck="false"
              />
              <div class="hidden items-center gap-2 md:flex">
                <span class="search-key">ESC</span>
                <span class="search-key search-key--accent">ENTER</span>
              </div>
            </div>
          </div>
        </div>

        <div class="search-panel-body relative min-h-0 flex-1 overflow-y-auto px-4 py-4 sm:px-7 sm:py-5">
          <div data-search-idle class="search-state-card px-5 py-8 text-center sm:px-6 sm:py-10">
            <div class="search-state-icon mx-auto flex h-16 w-16 items-center justify-center sm:h-18 sm:w-18">
              <Sparkles size={24} />
            </div>
            <p class="search-state-title mt-4 text-base font-semibold sm:mt-5 sm:text-lg">输入至少 2 个字符开始搜索</p>
            <p class="search-state-description mt-2 text-sm leading-6 sm:leading-7">会在文章标题与正文中同时检索，结果按标题优先排序。</p>
          </div>

          <div data-search-loading class="search-state-card hidden px-5 py-8 text-center sm:px-6 sm:py-10">
            <div class="search-state-icon mx-auto flex h-16 w-16 items-center justify-center sm:h-18 sm:w-18">
              <LoaderCircle size={24} class="animate-spin motion-reduce:animate-none" />
            </div>
            <p class="search-state-title mt-4 text-base font-semibold sm:mt-5 sm:text-lg">正在构建搜索索引</p>
            <p class="search-state-description mt-2 text-sm leading-6 sm:leading-7">首次打开时会懒加载数据与 FlexSearch。</p>
          </div>

          <div data-search-empty class="search-state-card hidden px-5 py-8 text-center sm:px-6 sm:py-10">
            <p class="search-state-title text-base font-semibold sm:text-lg">没有找到匹配结果</p>
            <p class="search-state-description mt-2 text-sm leading-6 sm:leading-7">试试更短的关键词，或换用标题中的核心词汇。</p>
          </div>

          <div data-search-results-wrap class="hidden space-y-4">
            <div class="flex flex-col items-start gap-2 px-1 sm:flex-row sm:items-center sm:justify-between sm:gap-3">
              <p data-search-meta class="search-results-meta text-sm font-medium"></p>
              <p class="search-results-hint text-xs uppercase">Enter 打开首个结果</p>
            </div>
            <div data-search-results class="space-y-3"></div>
          </div>
        </div>
      </section>
    </div>
  </div>
</div>

<script>
  import '../scripts/global-search.js';
</script>

<style>
  .search-overlay {
    transition: opacity var(--motion-slow) var(--ease-standard);
  }

  .search-backdrop {
    background: color-mix(in srgb, var(--color-canvas) 72%, transparent);
    backdrop-filter: blur(8px) saturate(108%);
  }

  .search-ambient {
    background: radial-gradient(circle at top, var(--color-brand-soft), transparent 72%);
  }

  .search-panel-shell {
    position: relative;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-dialog);
    background: linear-gradient(180deg, var(--color-surface-1), var(--color-surface-solid));
    box-shadow: var(--shadow-medium);
    backdrop-filter: blur(18px) saturate(112%);
    transition: transform var(--motion-slow) var(--ease-enter), opacity var(--motion-slow) var(--ease-standard);
  }

  .search-panel-shell::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 12% 10%, var(--color-brand-soft), transparent 23%),
      radial-gradient(circle at 86% 14%, color-mix(in srgb, var(--color-brand) 13%, transparent), transparent 20%);
    pointer-events: none;
  }

  .search-panel-noise {
    position: absolute;
    inset: 0;
    opacity: 0.025;
    pointer-events: none;
    background-image:
      linear-gradient(var(--color-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-border) 1px, transparent 1px);
    background-size: 24px 24px;
    mask-image: linear-gradient(180deg, rgba(255, 255, 255, 0.12), transparent 56%);
  }

  .search-panel-header {
    border-bottom: 1px solid var(--color-border);
    background: linear-gradient(180deg, var(--color-surface-3), var(--color-surface-1));
  }

  .search-dialog-icon,
  .search-input-icon,
  .search-state-icon {
    border-radius: var(--radius-panel);
    background: var(--color-brand-soft);
    color: var(--color-brand-strong);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-brand) 18%, transparent);
  }

  .search-input-icon {
    border-radius: var(--radius-pill);
  }

  .search-dialog-title,
  .search-state-title {
    color: var(--color-text-primary);
    font-family: var(--font-display);
    letter-spacing: -0.025em;
  }

  .search-dialog-subtitle,
  .search-state-description,
  .search-results-meta {
    color: var(--color-text-muted);
  }

  .search-close-button {
    flex: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface-1);
    color: var(--color-text-muted);
    transition: transform var(--motion-base) var(--ease-enter), color var(--motion-base) var(--ease-standard), border-color var(--motion-base) var(--ease-standard), background-color var(--motion-base) var(--ease-standard);
  }

  .search-input-shell,
  .search-state-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-panel);
    background: var(--color-surface-1);
    box-shadow: var(--shadow-low);
  }

  .search-input-shell {
    transition: border-color var(--motion-base) var(--ease-standard), box-shadow var(--motion-base) var(--ease-standard);
  }

  .search-input-shell:focus-within {
    border-color: color-mix(in srgb, var(--color-brand) 48%, transparent);
    box-shadow: var(--shadow-low), var(--shadow-focus);
  }

  .search-input {
    color: var(--color-text-primary);
    letter-spacing: -0.015em;
  }

  .search-input:focus-visible {
    box-shadow: none;
  }

  .search-input::placeholder {
    color: var(--color-text-muted);
    opacity: 0.72;
  }

  .search-key {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface-3);
    padding: 0.25rem 0.625rem;
    color: var(--color-text-muted);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
  }

  .search-key--accent {
    background: var(--color-brand-soft);
    color: var(--color-brand-strong);
  }

  .search-panel-body {
    background: linear-gradient(180deg, var(--color-surface-2), var(--color-surface-3));
  }

  .search-state-card {
    border-style: dashed;
  }

  .search-results-hint {
    color: var(--color-brand-strong);
    letter-spacing: 0.18em;
    opacity: 0.72;
  }

  .search-panel-active {
    animation: search-panel-glow var(--motion-slow) var(--ease-enter);
  }

  .search-state-card {
    animation: search-state-rise var(--motion-slow) var(--ease-enter);
  }

  :global(.search-result-item) {
    opacity: 0;
    transform: translateY(8px);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface-1);
    color: var(--color-text-primary);
    box-shadow: var(--shadow-low);
    animation: search-result-rise var(--motion-slow) var(--ease-enter) forwards;
    animation-delay: var(--search-stagger, 0ms);
    transition: transform var(--motion-base) var(--ease-enter), border-color var(--motion-base) var(--ease-standard), background-color var(--motion-base) var(--ease-standard), box-shadow var(--motion-base) var(--ease-standard);
  }

  :global(.search-result-title) {
    color: var(--color-text-primary);
    font-family: var(--font-display);
    letter-spacing: -0.02em;
    transition: color var(--motion-base) var(--ease-standard);
  }

  :global(.search-result-excerpt) { color: var(--color-text-secondary); }
  :global(.search-result-date) {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface-3);
    padding: 0.25rem 0.625rem;
    color: var(--color-text-muted);
  }

  :global(.search-result-badge) {
    border-radius: var(--radius-pill);
    padding: 0.25rem 0.625rem;
    font-size: 0.6875rem;
    font-weight: 600;
  }

  :global(.search-result-badge--title) { background: var(--color-brand-soft); color: var(--color-brand-strong); }
  :global(.search-result-badge--body) { background: var(--color-tag-soft); color: var(--color-tag); }

  @media (hover: hover) {
    .search-close-button:hover {
      transform: rotate(45deg);
      border-color: color-mix(in srgb, var(--color-brand) 42%, transparent);
      background: var(--color-brand-soft);
      color: var(--color-brand-strong);
    }

    :global(.search-result-item:hover) {
      transform: translateY(-2px);
      border-color: color-mix(in srgb, var(--color-brand) 42%, transparent);
      background: var(--color-surface-solid);
      box-shadow: var(--shadow-low);
    }

    :global(.search-result-item:hover .search-result-title) { color: var(--color-brand-strong); }
  }

  @keyframes search-panel-glow {
    0% {
      box-shadow: var(--shadow-low);
    }
    100% {
      box-shadow: var(--shadow-medium), 0 0 0 1px var(--color-brand-soft);
    }
  }

  @keyframes search-state-rise {
    0% {
      opacity: 0;
      transform: translateY(8px) scale(0.99);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes search-result-rise {
    0% {
      opacity: 0;
      transform: translateY(8px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .search-panel-active,
    .search-state-card,
    :global(.search-result-item) {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
