---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const tocItems = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{
  tocItems.length > 0 ? (
    <aside class="hidden w-56 shrink-0 xl:block">
      <nav class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto no-scrollbar" data-toc-nav aria-label="文章目录">
        <p class="toc-title mb-3 text-sm font-semibold">目录</p>
        <ul class="toc-list space-y-1 border-l text-sm">
          {tocItems.map((h) => (
            <li>
              <a
                href={`#${h.slug}`}
                data-toc-link={h.slug}
                class:list={[
                  'toc-link block border-l-2 border-transparent py-1',
                  h.depth === 3 ? 'ml-3 pl-3' : 'pl-3',
                ]}
              >
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>
  ) : null
}

<script>
  function initTocHighlight() {
    const nav = document.querySelector('[data-toc-nav]');
    if (!nav) return;

    const links = [...nav.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
    if (links.length === 0) return;

    const linkBySlug = new Map(links.map((link) => [link.dataset.tocLink, link]));
    const headings = links
      .map((link) => document.getElementById(link.dataset.tocLink ?? ''))
      .filter((el): el is HTMLElement => Boolean(el));

    if (headings.length === 0) return;

    let activeSlug = '';
    let scrollRaf = 0;

    function scrollToActive(link) {
      if (!link) return;
      const navRect = nav.getBoundingClientRect();
      const linkRect = link.getBoundingClientRect();
      // 让 active 项保持在 nav 中部附近，而非压在边缘
      const navMiddle = navRect.top + navRect.height / 2;
      const linkMiddle = linkRect.top + linkRect.height / 2;
      const distance = linkMiddle - navMiddle;
      // 超过 nav 高度 1/4 时才滚动，避免微小抖动
      if (Math.abs(distance) > navRect.height / 4) {
        cancelAnimationFrame(scrollRaf);
        scrollRaf = requestAnimationFrame(() => {
          const target = nav.scrollTop + distance;
          nav.scrollTo({ top: Math.max(0, target), behavior: 'smooth' });
        });
      }
    }

    function setActive(slug) {
      if (!slug || slug === activeSlug) return;
      activeSlug = slug;
      for (const link of links) {
        const isActive = link.dataset.tocLink === slug;
        link.classList.toggle('is-active', isActive);
      }
      scrollToActive(linkBySlug.get(slug));
    }

    // scroll-spy：跟踪哪个标题最接近视口顶部偏下一点的位置
    const observer = new IntersectionObserver(
      (entries) => {
        let candidate = null;
        for (const entry of entries) {
          if (entry.isIntersecting) {
            candidate = entry.target.id;
          }
        }
        if (candidate) {
          setActive(candidate);
          return;
        }
        // 交叉为空时（标题在上下两区之间），推断最近的上方标题
        const fallback = findNearestAbove();
        if (fallback) setActive(fallback);
      },
      {
        rootMargin: '-80px 0px -70% 0px',
        threshold: 0,
      },
    );

    function findNearestAbove() {
      const scrollY = window.scrollY + 100;
      let nearest = null;
      for (const h of headings) {
        if (h.offsetTop <= scrollY) {
          nearest = h.id;
        } else {
          break;
        }
      }
      return nearest;
    }

    for (const heading of headings) {
      observer.observe(heading);
    }

    // 点击目录项跳转后，确保对应项滚动到 nav 可视区
    links.forEach((link) => {
      link.addEventListener('click', () => {
        requestAnimationFrame(() => scrollToActive(link));
      });
    });
  }

  initTocHighlight();
</script>
