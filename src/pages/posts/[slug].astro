---
import { getCollection, render } from 'astro:content';
import SidebarNav from '../../components/SidebarNav.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import AiSummary from '../../components/AiSummary.astro';
import { getAllPosts, groupPostsByCategory, groupPostsByTag } from '../../lib/posts';

function normalizeDateInput(value: string): string {
  const trimmed = value.trim();
  if (/^\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}(:\d{2})?$/.test(trimmed)) {
    return trimmed.replace(/\s+/, 'T');
  }
  return trimmed;
}

function formatDate(value: string | Date | null): string {
  if (!value) return '未知';
  const date =
    value instanceof Date
      ? value
      : new Date(typeof value === 'string' ? normalizeDateInput(value) : value);
  if (Number.isNaN(date.getTime())) return '未知';
  return new Intl.DateTimeFormat('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
  }).format(date);
}

export async function getStaticPaths() {
  const entries = await getCollection('posts');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(entry);
const data = entry.data;

const allPosts = await getAllPosts();
const categories = groupPostsByCategory(allPosts);
const tags = groupPostsByTag(allPosts);
const categoryEntries = [...categories.entries()];
const tagEntries = [...tags.entries()];

const updatedField = data.updated ?? data.date ?? null;
const updatedTime = formatDate(updatedField ?? null);

// remarkReadingTime 插件在 Content Collections render() 下可读取到
const totalWords = remarkPluginFrontmatter.totalWords ?? 0;
const readingMinutes = remarkPluginFrontmatter.minutesRead ?? 1;

const postCategories = Array.isArray(data.categories)
  ? data.categories
  : typeof data.categories === 'string'
    ? [data.categories]
    : [];
const postTags = Array.isArray(data.tags)
  ? data.tags
  : typeof data.tags === 'string'
    ? [data.tags]
    : [];
const activeCategory = postCategories.length > 0 ? String(postCategories[0]) : null;
const activeTag = postTags.length > 0 ? String(postTags[0]) : null;
const siteUrl = Astro.site ?? new URL('https://arkpln.netlify.app');
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const titleText = String(data.title ?? '文章');
const descriptionText = String(data.description ?? `${titleText} - 蔚蓝之家`);
const ogImage = data.cover
  ? new URL(String(data.cover), siteUrl).toString()
  : undefined;
---

<BaseLayout
  title={titleText}
  description={descriptionText}
  canonical={canonical}
  ogType="article"
  ogImage={ogImage}
>
  <div class="post-bg-wrap" aria-hidden="true">
    <div
      class="post-bg-layer post-bg-light bg-cover bg-center bg-no-repeat"
      style="background-image: url('/image/BG_View_Sky2.webp');"
    ></div>
    <div
      class="post-bg-layer post-bg-dark bg-cover bg-center bg-no-repeat"
      style="background-image: url('/image/night/BG_CommitteeRoom_Night.webp');"
    ></div>
    <div class="post-bg-overlay"></div>
  </div>

  <div class="pt-16">
    <aside class="max-h-[46vh] overflow-y-auto no-scrollbar border-b border-slate-200 bg-white/85 px-4 py-3 backdrop-blur-sm dark:border-slate-700 dark:bg-slate-800/85 lg:fixed lg:left-0 lg:top-16 lg:z-30 lg:h-[calc(100vh-4rem)] lg:max-h-none lg:w-[280px] lg:border-b-0 lg:border-r lg:p-4">
      <SidebarNav
        categoryEntries={categoryEntries}
        tagEntries={tagEntries}
        activeCategory={activeCategory}
        activeTag={activeTag}
      />
    </aside>

    <main class="min-h-[calc(100vh-4rem)] lg:ml-[280px]">
      <div class="mx-auto w-full max-w-[1200px] p-4 lg:px-6 lg:py-4 xl:px-8">
        <div class="flex gap-8">
          <section class="min-w-0 flex-1">
            <a href="/" class="text-sm text-sky-700 hover:underline dark:text-sky-400">← 返回首页</a>
            <h1 class="mt-3 text-2xl font-bold text-slate-900 sm:text-3xl dark:text-slate-100">{titleText}</h1>
            <div class="mt-4 flex flex-wrap gap-2 text-xs text-slate-600 dark:text-slate-300">
              <span class="rounded-full bg-slate-200 px-3 py-1 dark:bg-slate-700">更新时间：{updatedTime}</span>
              <span class="rounded-full bg-slate-200 px-3 py-1 dark:bg-slate-700">总字数：{totalWords}</span>
              <span class="rounded-full bg-slate-200 px-3 py-1 dark:bg-slate-700">预计阅读：{readingMinutes} 分钟</span>
            </div>
            <AiSummary
              slug={entry.id}
              version={String(updatedField ?? '')}
            />
            <article class="markdown-content mt-4 w-full rounded-xl bg-white/85 p-4 shadow-sm backdrop-blur-sm sm:p-6 md:p-8 dark:bg-slate-800/85">
              <Content />
            </article>
          </section>

          <TableOfContents headings={headings} />
        </div>
      </div>
    </main>
  </div>
</BaseLayout>

<style>
  .post-bg-wrap {
    position: fixed;
    inset: 0;
    z-index: -20;
    pointer-events: none;
    overflow: hidden;
  }

  .post-bg-layer {
    position: absolute;
    inset: 0;
    transition: opacity 900ms ease-in-out;
  }

  .post-bg-light {
    opacity: 1;
  }

  .post-bg-dark {
    opacity: 0;
  }

  :global(.dark) .post-bg-light {
    opacity: 0;
  }

  :global(.dark) .post-bg-dark {
    opacity: 1;
  }

  .post-bg-overlay {
    position: absolute;
    inset: 0;
    background: rgba(241, 245, 249, 0.78);
    transition: background 900ms ease-in-out;
  }

  :global(.dark) .post-bg-overlay {
    background: rgba(11, 17, 32, 0.82);
  }
</style>

<script>
  import '../../scripts/mermaid-init';
</script>
