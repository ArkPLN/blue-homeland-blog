---
import SidebarNav from '../../components/SidebarNav.astro';
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllPosts, groupPostsByCategory, groupPostsByTag } from '../../lib/posts';

const allPosts = await getAllPosts();
const categories = groupPostsByCategory(allPosts);
const tags = groupPostsByTag(allPosts);

const categoryEntries = [...categories.entries()];
const tagEntries = [...tags.entries()];

export async function getStaticPaths() {
  const posts = await getAllPosts();
  const grouped = groupPostsByCategory(posts);
  return [...grouped.keys()].map((category) => ({
    params: { category },
  }));
}

const { category } = Astro.params;
const currentCategory = category ?? '';
const categoryPosts = categories.get(currentCategory) ?? [];
const siteUrl = Astro.site ?? new URL('https://arkpln.netlify.app');
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const pageTitle = `分类：${currentCategory} - 蔚蓝之家`;
const pageDescription = `浏览分类「${currentCategory}」下的全部文章。`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  ogType="website"
>
  <div class="page-bg-wrap" aria-hidden="true">
    <div
      class="page-bg-layer page-bg-light bg-cover bg-center bg-no-repeat"
      style="background-image: url('/image/BG_View_Sky2.webp');"
    ></div>
    <div
      class="page-bg-layer page-bg-dark bg-cover bg-center bg-no-repeat"
      style="background-image: url('/image/night/BG_CommitteeRoom_Night.webp');"
    ></div>
    <div class="page-bg-overlay"></div>
  </div>

  <div class="pt-16">
    <aside class="content-sidebar">
      <SidebarNav
        categoryEntries={categoryEntries}
        tagEntries={tagEntries}
        activeCategory={currentCategory}
      />
    </aside>

    <main class="min-h-[calc(100vh-4rem)] p-4 lg:ml-[280px]">
      <section class="mx-auto max-w-6xl space-y-6">
        <PostList title={`分类：${currentCategory}`} posts={categoryPosts} emptyText="该分类下暂无文章。" />
      </section>
    </main>
  </div>
</BaseLayout>
