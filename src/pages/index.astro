---
import { getAllPosts, groupPostsByCategory, groupPostsByTag } from '../lib/posts';
import SidebarNav from '../components/SidebarNav.astro';
import PostList from '../components/PostList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = getAllPosts();
const categories = groupPostsByCategory(posts);
const tags = groupPostsByTag(posts);

const categoryEntries = [...categories.entries()];
const tagEntries = [...tags.entries()];
const siteUrl = Astro.site ?? new URL('https://arkpln.netlify.app');
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const pageTitle = '蔚蓝之家';
const pageDescription = '蔚蓝之家是一个以前端开发、全栈实践与 AI 应用探索为主题的中文技术博客，提供最新文章、分类归档与标签导航，帮助你快速发现高价值内容。';
const pageKeywords = '蔚蓝之家,中文技术博客,前端开发,全栈开发,AI应用,Astro,文章归档,分类,标签';
const websiteStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: '蔚蓝之家',
  url: canonical,
  inLanguage: 'zh-CN',
  description: pageDescription,
  author: {
    '@type': 'Person',
    name: 'ArkPLN',
  },
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  ogType="website"
  keywords={pageKeywords}
>
  <script type="application/ld+json" set:html={JSON.stringify(websiteStructuredData)} slot="head" />

  <div class="home-bg-wrap" aria-hidden="true">
    <div class="home-bg-layer home-bg-light">
      <div class="home-bg-slide home-bg-1"></div>
      <div class="home-bg-slide home-bg-2"></div>
      <div class="home-bg-slide home-bg-3"></div>
      <div class="home-bg-slide home-bg-4"></div>
    </div>
    <div class="home-bg-layer home-bg-dark">
      <div class="home-bg-slide home-night-1"></div>
      <div class="home-bg-slide home-night-2"></div>
      <div class="home-bg-slide home-night-3"></div>
      <div class="home-bg-slide home-night-4"></div>
    </div>
    <div class="home-bg-gradient"></div>
  </div>

  <div class="pt-16">
    <aside
      class="max-h-[46vh] overflow-y-auto no-scrollbar border-b border-slate-200 bg-white/85 px-4 py-3 backdrop-blur-sm dark:border-slate-700 dark:bg-slate-800/85 lg:fixed lg:left-0 lg:top-16 lg:z-30 lg:h-[calc(100vh-4rem)] lg:max-h-none lg:w-[280px] lg:border-b-0 lg:border-r lg:p-4"
    >
      <SidebarNav
        categoryEntries={categoryEntries}
        tagEntries={tagEntries}
      />
    </aside>

    <main class="min-h-[calc(100vh-4rem)] p-4 lg:ml-[280px]">
      <section class="mx-auto max-w-6xl space-y-3">
        <PostList title="最新文章" posts={posts} />
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  .home-bg-wrap {
    position: fixed;
    inset: 0;
    z-index: -20;
    pointer-events: none;
    overflow: hidden;
  }

  .home-bg-layer {
    position: absolute;
    inset: 0;
    overflow: hidden;
    transition: opacity 900ms ease-in-out;
  }

  .home-bg-light {
    opacity: 1;
  }

  .home-bg-dark {
    opacity: 0;
  }

  :global(.dark) .home-bg-light {
    opacity: 0;
  }

  :global(.dark) .home-bg-dark {
    opacity: 1;
  }

  .home-bg-slide {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0;
    animation: bg-rotate 24s linear infinite;
  }

  .home-bg-1 {
    background-image: url("/image/BG_View_Sky2.webp");
    animation-delay: 0s;
  }

  .home-bg-2 {
    background-image: url("/image/BG_View_Kivotos.webp");
    animation-delay: 6s;
  }

  .home-bg-3 {
    background-image: url("/image/BG_IslandBeach.webp");
    animation-delay: 12s;
  }

  .home-bg-4 {
    background-image: url("/image/BG_View_Sky.webp");
    animation-delay: 18s;
  }

  .home-night-1 {
    background-image: url("/image/night/BG_CommitteeRoom_Night.webp");
    animation-delay: 0s;
  }

  .home-night-2 {
    background-image: url("/image/night/BG_BuildingRooftop_Night.webp");
    animation-delay: 6s;
  }

  .home-night-3 {
    background-image: url("/image/night/BG_BeachFrontSide_Night.webp");
    animation-delay: 12s;
  }

  .home-night-4 {
    background-image: url("/image/night/BG_Beachside_Night.webp");
    animation-delay: 18s;
  }

  .home-bg-gradient {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        130deg,
        rgba(241, 245, 249, 0.82) 0%,
        rgba(241, 245, 249, 0.72) 42%,
        rgba(226, 232, 240, 0.8) 100%
      );
    animation: gradient-flow 8s ease-in-out infinite alternate;
    transition: opacity 900ms ease-in-out;
  }

  :global(.dark) .home-bg-gradient {
    background:
      linear-gradient(
        130deg,
        rgba(11, 17, 32, 0.88) 0%,
        rgba(11, 17, 32, 0.82) 42%,
        rgba(15, 23, 42, 0.9) 100%
      );
  }

  @keyframes bg-rotate {
    0% {
      opacity: 0;
    }
    8% {
      opacity: 1;
    }
    25% {
      opacity: 1;
    }
    33% {
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes gradient-flow {
    0% {
      opacity: 0.88;
    }
    100% {
      opacity: 0.72;
    }
  }
</style>
