---
import { BookOpenText, GitBranch, Globe } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const profile = {
  username: 'ArkPLN',
  bio: 'A fullstack Developer. Keep learning!',
  avatar: 'https://avatars.githubusercontent.com/u/178480666?v=4',
  company: 'S.C.H.A.L.E',
  location: 'Kivotos',
  blog: 'https://arkpln.github.io',
  github: 'https://github.com/ArkPLN',
  juejin: 'https://juejin.cn/user/4484239094198752',
  followers: 2,
  publicRepos: 6,
  joinedAt: '2024-08-15',
  profileUpdatedAt: '2026-07-17',
};

const featuredRepos = [
  {
    name: 'dbx',
    href: 'https://github.com/ArkPLN/dbx',
    description: '轻量级跨平台数据库客户端（fork），支持 MySQL、PostgreSQL、SQLite、Redis 等 90+ 数据库，内置 AI、MCP Server、CLI 与桌面端。',
    stack: 'Rust',
    stars: 0,
    updatedAt: '2026-08-27',
  },
  {
    name: 'ArkPLN.github.io',
    href: 'https://github.com/ArkPLN/ArkPLN.github.io',
    description: '个人站点仓库，持续更新博客与前端展示页面。',
    stack: 'HTML / CSS / JavaScript',
    stars: 1,
    updatedAt: '2026-06-10',
  },
  {
    name: 'MiniWordCards',
    href: 'https://github.com/ArkPLN/MiniWordCards',
    description: '「小小词卡」轻量 Flutter 词汇学习应用，支持 CSV 导入、快速查词和抽认卡复习，面向小众词表场景。',
    stack: 'Flutter / Dart / HTML',
    stars: 0,
    updatedAt: '2026-05-08',
  },
  {
    name: 'ThinkCMF6-Skills',
    href: 'https://github.com/ArkPLN/ThinkCMF6-Skills',
    description: 'ThinkCMF6 文档非官方 Skills 封装，适配 Cursor、Claude Code、Codex、GitHub Copilot 等 AI 编码工具。',
    stack: 'Python / ThinkCMF6 / PHP',
    stars: 0,
    updatedAt: '2026-05-06',
  },
  {
    name: 'better-react-skills',
    href: 'https://github.com/ArkPLN/better-react-skills',
    description: '围绕 React 前端工程实践整理的技能与指导仓库，面向 Agent Skills 提供更稳定的高质量指引。',
    stack: 'React / Frontend Guidelines',
    stars: 3,
    updatedAt: '2026-01-24',
  },
];
const siteUrl = Astro.site ?? new URL('https://arkpln.netlify.app');
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const pageTitle = 'About | 蔚蓝之家';
const pageDescription = '关于蔚蓝之家与作者 ArkPLN 的简介、项目与公开仓库信息。';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  ogType="website"
  siteHeaderProps={{ showHomeLink: true, showAboutLink: false }}
>
  <div class="page-bg-wrap" aria-hidden="true">
    <div
      class="page-bg-layer page-bg-light bg-cover bg-center bg-no-repeat"
      style="background-image: url('/image/BG_View_Sky2.webp');"
    ></div>
    <div
      class="page-bg-layer page-bg-dark bg-cover bg-center bg-no-repeat"
      style="background-image: url('/image/night/BG_CommitteeRoom_Night.webp');"
    ></div>
    <div class="page-bg-overlay"></div>
  </div>

  <main class="mx-auto w-full max-w-6xl space-y-6 p-4 pt-20">
    <section class="surface-panel p-6">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="eyebrow">ABOUT</p>
          <h2 class="page-title mt-1 text-3xl font-bold">{profile.username}</h2>
          <p class="card-copy mt-3 text-sm">{profile.bio}</p>
          <div class="mt-4 flex flex-wrap gap-2">
            <a
              href={profile.github}
              target="_blank"
              rel="noreferrer"
              class="profile-action profile-action--github"
            >
              <GitBranch size={16} />
              GitHub主页
            </a>
            <a
              href={profile.blog}
              target="_blank"
              rel="noreferrer"
              class="profile-action profile-action--blog"
            >
              <Globe size={16} />
              个人博客（旧）
            </a>
            <a
              href={profile.juejin}
              target="_blank"
              rel="noreferrer"
              class="profile-action profile-action--juejin"
            >
              <BookOpenText size={16} />
              掘金社区
            </a>
          </div>
        </div>
        <img
          src={profile.avatar}
          alt={`${profile.username} avatar`}
          class="profile-avatar h-20 w-20 shrink-0 rounded-full object-cover md:h-24 md:w-24"
          loading="lazy"
          referrerpolicy="no-referrer"
        />
      </div>
    </section>

    <section class="grid gap-6 md:grid-cols-2">
      <article class="surface-panel p-6">
        <h3 class="section-title text-lg font-semibold">Profile Snapshot</h3>
        <ul class="mt-4 space-y-2 text-sm">
          <li class="profile-row flex items-center justify-between pb-2"><span class="profile-label">Company</span><strong class="profile-value">{profile.company}</strong></li>
          <li class="profile-row flex items-center justify-between pb-2"><span class="profile-label">Location</span><strong class="profile-value">{profile.location}</strong></li>
          <li class="profile-row flex items-center justify-between pb-2"><span class="profile-label">Joined GitHub</span><strong class="profile-value">{profile.joinedAt}</strong></li>
          <li class="profile-row flex items-center justify-between pb-2"><span class="profile-label">Followers</span><strong class="profile-value">{profile.followers}</strong></li>
          <li class="profile-row flex items-center justify-between pb-2"><span class="profile-label">Public Repos</span><strong class="profile-value">{profile.publicRepos}</strong></li>
          <li class="flex items-center justify-between"><span class="profile-label">Profile Updated</span><strong class="profile-value">{profile.profileUpdatedAt}</strong></li>
        </ul>
      </article>

      <article class="surface-panel p-6">
        <h3 class="section-title text-lg font-semibold">Focus</h3>
        <p class="card-copy mt-4 text-sm leading-7">
          关注AI前沿技术发展，专注AI应用+大前端开发领域，积极探索AI在前端工程中的应用与工程化实践，分享在学习和项目开发中的心得体会。
        </p>
          <p class="muted-text mt-3 text-xs">Data source: GitHub public profile and repositories (2026-08-31)</p>
      </article>
    </section>

    <section class="surface-panel p-6">
      <div class="flex items-center justify-between gap-3">
        <h3 class="section-title text-lg font-semibold">Featured Repositories</h3>
        <a
          href={profile.github + '?tab=repositories'}
          target="_blank"
          rel="noreferrer"
          class="text-link text-sm font-medium"
        >
          View All
        </a>
      </div>

      <div class="mt-4 grid gap-3">
        {
          featuredRepos.map((repo) => (
            <a
              href={repo.href}
              target="_blank"
              rel="noreferrer"
              class="surface-card interactive-card p-4"
            >
              <h4 class="card-title text-base font-semibold">{repo.name}</h4>
              <p class="card-copy mt-1 text-sm">{repo.description}</p>
              <div class="card-meta mt-3 flex flex-wrap gap-3 text-xs">
                <span>Stack: {repo.stack}</span>
                <span>Stars: {repo.stars}</span>
                <span>Updated: {repo.updatedAt}</span>
              </div>
            </a>
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>
